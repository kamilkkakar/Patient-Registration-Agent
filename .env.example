# Copy to .env and fill in. NEVER commit .env.
# Every value below is a placeholder — no real credentials belong in this file.

# --- Database ---
# Local example: postgresql://postgres:postgres@localhost:55432/patient_registration
# Railway injects its own DATABASE_URL in production.
DATABASE_URL=postgresql://user:password@host:5432/patient_registration

# --- Server ---
PORT=3000
# Interface to bind. Must stay 0.0.0.0 on Railway/Docker; loopback there makes
# the health check fail silently.
HOST=0.0.0.0
NODE_ENV=development
# pino level: fatal|error|warn|info|debug|trace|silent. The test suite forces `silent`.
LOG_LEVEL=info

# Public base URL of this API, used when registering Vapi tool webhooks.
# Local dev: your ngrok HTTPS URL. Production: the Railway domain.
PUBLIC_BASE_URL=https://example.up.railway.app

# --- Vapi (telephony + voice orchestration) ---
# Private API key from https://dashboard.vapi.ai — server-side only.
VAPI_API_KEY=
# Shared secret used to verify that a webhook request really came from Vapi.
# NOTE: the legacy `server.secret` / `X-Vapi-Secret` mechanism is gone from the current API schema.
# We send this as a custom header via the assistant's `server.headers` config instead, and compare
# it on every inbound /vapi/* request.
VAPI_WEBHOOK_SECRET=
# Populated after the assistant and number are provisioned.
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# --- LLM ---
# Only needed if bringing your own key rather than using Vapi's managed provider.
OPENAI_API_KEY=
